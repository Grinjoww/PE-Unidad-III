@startuml c4-contexto
title Diagrama de Contexto (C4 Nivel 1) - Sistema PFC, Equipo H

left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultTextAlignment center
skinparam roundcorner 10
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 60

skinparam rectangle {
  BackgroundColor<<system>> #1168BD
  FontColor<<system>> #FFFFFF
  BorderColor<<system>> #0B4884
}

skinparam actor {
  BackgroundColor #08427B
  FontColor #FFFFFF
  BorderColor #052C50
}

actor "Usuario final\n<size:11><i>[Persona]</i></size>\n\nEstudiante o miembro del\nequipo que consulta y\ngestiona datos del sistema." as usuario
actor "Administrador\n<size:11><i>[Persona]</i></size>\n\nUsuario con permisos\nelevados para gestionar\nel sistema." as admin

rectangle "Sistema PFC\n<size:11><i>[Sistema de software]</i></size>\n\nPermite gestionar información\nmediante operaciones CRUD,\ncon autenticación y caché.\n\nJava 21 + Spring Boot 3.x +\nAngular 17+ + PostgreSQL 16 + Redis 7" as sistemaPFC <<system>>

usuario -right-> sistemaPFC : Usa\n<<HTTPS>>
admin -right-> sistemaPFC : Administra\n<<HTTPS>>

legend right
  |= Elemento |= Significado |
  | <back:#08427B>   </back> | Persona (actor externo) |
  | <back:#1168BD>   </back> | Sistema de software (caja negra) |
  Nota: no se identifican sistemas externos
  reales hasta que Jaime confirme integraciones.
endlegend

@enduml
