@startuml seq-read-through
title "Flujo TEÓRICO: Read-Through (patrón NO implementado en BIOPET)"

skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam roundcorner 6
skinparam maxMessageSize 220

skinparam participant {
  BackgroundColor<<frontend>> #6C3483
  FontColor<<frontend>> #FFFFFF
  BorderColor<<frontend>> #4A235A
  BackgroundColor<<backend>> #1168BD
  FontColor<<backend>> #FFFFFF
  BorderColor<<backend>> #0B4884
  BackgroundColor<<cache>> #C0392B
  FontColor<<cache>> #FFFFFF
  BorderColor<<cache>> #7B241C
  BackgroundColor<<db>> #2E7D32
  FontColor<<db>> #FFFFFF
  BorderColor<<db>> #1B5E20
}

participant "Frontend" as FE <<frontend>>
participant "Aplicación" as APP <<backend>>
participant "Librería de caché\n(read-through)" as CACHE <<cache>>
participant "Base de datos" as DB <<db>>

note over APP, CACHE #FFF3CD
  ESTE FLUJO ES TEÓRICO. BIOPET usa cache-aside,
  no read-through. Aquí, a diferencia de cache-aside,
  es la propia librería de caché la que consulta la
  base de datos en caso de miss, no la aplicación.
end note

FE -> APP : Solicita dato
APP -> CACHE : get(clave)
alt Cache HIT
  CACHE --> APP : dato (resuelto internamente)
else Cache MISS
  CACHE -> DB : la librería consulta la BD directamente
  DB --> CACHE : resultado
  CACHE -> CACHE : guarda el resultado
  CACHE --> APP : dato
end
APP --> FE : respuesta

@enduml
